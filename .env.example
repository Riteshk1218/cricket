# Copy this file to backend\.env (Windows: copy .env.example backend\.env) and edit.
# Never commit a real .env file. These values are for local development only.

# --- Django ---
DJANGO_DEBUG=true
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# With DEBUG on, any host is allowed so phones on your Wi-Fi can connect.
# With DEBUG off, list the hosts, e.g. localhost,127.0.0.1,192.168.1.10
DJANGO_ALLOWED_HOSTS=
DJANGO_TIME_ZONE=Asia/Kolkata

# --- PostgreSQL ---
POSTGRES_DB=cricket_live
POSTGRES_USER=cricket
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Realtime ---
# Leave empty to use the built-in in-memory channel layer (fine for one server
# process on one laptop). Set it to use Redis/Memurai, e.g. redis://127.0.0.1:6379/0
REDIS_URL=

# --- Optional ---
# Salt for hashing anonymous visitor ids (defaults to the secret key)
ANALYTICS_SALT=
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
ANON_THROTTLE_RATE=600/minute
AUTH_THROTTLE_RATE=20/minute
LOG_LEVEL=INFO
